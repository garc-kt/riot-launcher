{
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@riot/contracts": ["../packages/contracts/src/index.ts"],
      "@riot/contracts/*": ["../packages/contracts/src/*"],
      "@riot/i18n": ["../packages/i18n/src/index.ts"],
      "@riot/ui": ["../packages/ui/src/index.ts"],
      "@riot/ui/*": ["../packages/ui/src/*"]
    },
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}